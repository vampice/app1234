<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:app"
    Title="app"
    FlyoutBehavior="Flyout">

    <TabBar Title="Color Tools">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate local:HistoryPage}"
            Route="HistoryPage" />
    </TabBar>

    <MenuItem Text="Home" Clicked="OnHomeClicked" />
    <MenuItem Text="Character" Clicked="Character_Clicked" />
    <MenuItem Text="About" Clicked="OnAboutClicked" />
    

</Shell>
