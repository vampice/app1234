<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app.AboutPage"
             Title="About">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="About"
                   FontSize="32"
                   FontAttributes="Bold" />
            <Label Text="Random Color"
                   FontSize="22"
                   FontAttributes="Bold" />
            <Label Text="Create and explore random color palettes from the home page."
                   FontSize="16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
